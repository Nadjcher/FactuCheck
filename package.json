{
  "name": "factucheck",
  "version": "0.1.0",
  "private": true,
  "description": "Testez vos factures electroniques avant envoi. Zero rejet, zero retard de paiement.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "schematron:official": "node scripts/fetch-official-schematron.mjs",
    "corpus:generate": "node scripts/generate-corpus.mjs",
    "corpus:pdf": "node scripts/make-facturx-pdf.mjs",
    "coverage:matrix": "node scripts/coverage-matrix.mjs",
    "diff:setup": "node scripts/fetch-official-schematron.mjs && node scripts/diff-saxon.mjs",
    "diff:run": "SAXON_DIR=.saxon DIFF_CORPUS=fixtures-corpus vitest run differential.saxon",
    "verapdf:setup": "node scripts/verapdf-setup.mjs",
    "verapdf:run": "VERAPDF_CLI=.verapdf/app/verapdf vitest run verapdf.pdfa",
    "xsd:setup": "node scripts/fetch-xsd.mjs",
    "xsd:serve": "SCHEMAS_DIR=services/xsd/schemas node services/xsd/server.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^4.5.0",
    "lucide-react": "^0.454.0",
    "next": "^14.2.35",
    "node-schematron": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.2.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.1",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
