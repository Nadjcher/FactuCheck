# ----------------------------------------------------------------------------
# FactuCheck - variables d'environnement
# Copiez ce fichier en `.env.local` et renseignez vos valeurs.
# L'application DEMARRE sans ces cles (mode demo), mais l'auth, le stockage
# et le paiement sont alors desactives.
# ----------------------------------------------------------------------------

# Supabase (hebergement UE : choisissez une region europeenne)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cle service-role : UNIQUEMENT cote serveur, jamais exposee au client
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# IDs de prix Stripe (plans Pro / Cabinet)
STRIPE_PRICE_PRO=
STRIPE_PRICE_CABINET=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Retention : suppression auto des fichiers (en jours, defaut 30)
FACTUCHECK_RETENTION_DAYS=30

# Service de validation PDF/A-3 (veraPDF). Optionnel : si absent, la validation
# PDF/A-3 complete n'est pas executee (controle partiel). Voir services/verapdf/.
# Ex. : http://localhost:8083  (dev)  ou  http://verapdf:8083  (docker-compose)
VERAPDF_SERVICE_URL=

# Service de validation XSD (structure CII/UBL, xmllint). Optionnel : si absent,
# la validation structurelle complete n'est pas executee. Voir services/xsd/.
# Ex. : http://localhost:8084  (dev)  ou  http://xsd:8084  (docker-compose)
# Avec veraPDF + XSD branches, un Factur-X conforme n'est plus « Controle partiel ».
XSD_SERVICE_URL=

# API publique : cles valides (separees par des virgules). La cle "demo" marche
# toujours (bridee). Ex. : FACTUCHECK_API_KEYS=k_live_abc,k_live_def
FACTUCHECK_API_KEYS=

# Webhook email entrant : jeton secret de /api/email/inbound?token=...
EMAIL_INBOUND_SECRET=
