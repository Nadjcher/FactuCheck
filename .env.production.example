# FactuCheck — variables d'environnement de PRODUCTION
# Toutes sont OPTIONNELLES : absentes, la fonctionnalité se désactive proprement
# (mode démo / contrôle partiel). Renseignez-les dans votre hébergeur (Vercel →
# Settings → Environment Variables), PAS dans un fichier versionné.

# --- URL publique de l'app (pour les liens, Stripe, etc.) ---
NEXT_PUBLIC_APP_URL=https://votre-domaine.fr

# --- Services de validation (étape 1.b) — réseau interne, pas d'exposition publique ---
# Sans eux : rapport « Contrôle partiel » (honnête).
XSD_SERVICE_URL=
VERAPDF_SERVICE_URL=

# --- Supabase (étape 2 : comptes, historique) — région UE ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service-role : SERVEUR UNIQUEMENT, jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (étape 2 : abonnements) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CABINET=

# --- Rétention des fichiers (RGPD) : suppression auto en jours ---
FACTUCHECK_RETENTION_DAYS=30
